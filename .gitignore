# WordPress-Core
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
/.htaccess

# Plugins, Uploads und andere WordPress-Inhalte bleiben außerhalb von Git.
# Git muss den themes-Ordner sehen, bevor es das Child-Theme freigeben kann.
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/hochschulwatch/

# Lokale Konfiguration, Logs und Backups
.env
.env.*
wp-config*.php
*.log
/backup/
/backups/
*.sql
*.sql.*
*.sqlite*
*.wpress
